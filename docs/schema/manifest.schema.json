{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footera.local/schema/manifest.schema.json",
  "title": "FOOTERA — Manifesto do pacote de dados",
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
      },
      "maxItems": 50
    },
    "base": {
      "type": "string",
      "enum": [
        "generated",
        "none"
      ]
    }
  },
  "required": [
    "format",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false
}
