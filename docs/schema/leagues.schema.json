{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footera.local/schema/leagues.schema.json",
  "title": "FOOTERA — Ligas",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
      },
      "$remove": {
        "const": true
      },
      "country": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "rules": {
        "type": "object",
        "properties": {
          "rounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "pointsWin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "pointsDraw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "promotionSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "relegationSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "continentalSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "maxForeignPlayers": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "squadMin": {
            "type": "integer",
            "minimum": 14,
            "maximum": 30
          },
          "squadMax": {
            "type": "integer",
            "minimum": 18,
            "maximum": 40
          },
          "calendar": {
            "type": "object",
            "properties": {
              "seasonStart": {
                "type": "string",
                "pattern": "^\\d{2}-\\d{2}$"
              },
              "matchWeekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "intervalDays": {
                "type": "integer",
                "minimum": 3,
                "maximum": 14
              }
            },
            "required": [
              "seasonStart",
              "matchWeekday",
              "intervalDays"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "active": {
        "type": "boolean"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  }
}
