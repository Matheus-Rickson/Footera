{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footera.local/schema/stadiums.schema.json",
  "title": "FOOTERA — Estádios",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
      },
      "$remove": {
        "const": true
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "city": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "capacity": {
        "type": "integer",
        "minimum": 500,
        "maximum": 250000
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  }
}
